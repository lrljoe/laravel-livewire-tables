includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon
  
parameters:
    paths:
        - database
        - src
    level: 6
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - identifier: argument.templateType
          paths:
           - src/Features/Filters/Views/MultiSelectDropdownFilter.php
           - src/Features/Filters/Views/SelectFilter.php
        - identifier: new.static
        - identifier: missingType.generics
          paths:
            - src/Traits/WithData.php
        - identifier: empty.offset
          paths:
            - src/Features/Filters/Traits/Helpers/FilterMenuHelpers.php
        - identifier: isset.offset
          paths:
            - src/Features/Filters/Traits/Helpers/FilterMenuHelpers.php
        - message: '# \$view of function view expects view-string\|null, string given.#'
